

# Application Configuration
APP_NAME=FraudLens
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_USER=fraudlens_admin
POSTGRES_PASSWORD=fraudlens_secure_pass
POSTGRES_DB=fraudlens
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://fraudlens_admin:fraudlens_secure_pass@localhost:5433/fraudlens
DATABASE_SYNC_URL=postgresql://fraudlens_admin:fraudlens_secure_pass@localhost:5433/fraudlens

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraudlens_neo4j_pass
NEO4J_DATABASE=neo4j

# Redis Cache & Message Broker (Phase 4 / Stretch)
REDIS_URL=redis://localhost:6379/0

# Razorpay Integration (Test Mode — Phase 5)
RAZORPAY_KEY_ID=rzp_test_example_key
RAZORPAY_KEY_SECRET=rzp_test_example_secret
RAZORPAY_WEBHOOK_SECRET=whsec_fraudlens_test_secret

# AI Agent & Analyst Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANALYST_SECRET_KEY=fraudlens_demo_analyst_2026

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
